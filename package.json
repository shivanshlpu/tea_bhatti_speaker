{
  "name": "cafe-voice-system",
  "version": "1.0.0",
  "description": "Cafe Voice Announcement System — tap to announce menu items over speakers",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "electron .",
    "build": "electron-builder",
    "seed": "node backend/db/seed.js",
    "postinstall": "node backend/scripts/downloadVoices.js && node backend/scripts/downloadPiperBinary.js"
  },
  "dependencies": {
    "sql.js": "1.12.0",
    "express": "4.21.2",
    "socket.io": "4.8.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "electron": "35.1.2",
    "electron-builder": "25.1.8",
    "nodemon": "3.1.9"
  },
  "build": {
    "appId": "com.cafe.voice-system",
    "productName": "Cafe Voice System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/**/*",
      "tts-runtime/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
